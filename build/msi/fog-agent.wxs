<?xml version="1.0" encoding="utf-8"?>
<!--
  FOG Agent Windows installer, built on Linux with wixl (msitools).
  build/msi.sh cross-compiles the exe and runs wixl with -D Version=x.y.z.

  What the package owns: the exe under Program Files\FOG, the fog-agent
  service (registered, started, stopped and removed by Windows Installer
  itself), and retiring the legacy "FOG Service" client. What it hands to
  the agent: `fog-agent setup`, run once as SYSTEM after the files land,
  which settles the state directory and makes the first enrollment
  request from SERVER, CA and TOKEN. A server that does not answer at
  install time is not an install failure; the service keeps trying.

  Two ways in. A double-click walks a wizard that asks for the three
  values below (the FogUI fragment at the foot of this file); a scripted
  install passes them as properties and never sees a dialog, because /qn
  and /qb skip the InstallUISequence entirely.

  Properties, all optional on an upgrade because the state directory is
  kept:
    SERVER      base URL, e.g. https://fog.example.org/fog
    CA          path to a saved copy of the certificate to trust, PEM or
                DER: the FOG CA the server publishes at
                management/other/ca.cert.pem, or the public CA the web UI
                uses. The agent trusts only what it is given
    TOKEN       enrollment token minted by an admin
    WEBADDRESS, WEBROOT
                the legacy client's names, honored when SERVER is absent:
                SERVER becomes https://[WEBADDRESS][WEBROOT]

  Logs: the agent's own at C:\ProgramData\FOG\fog-agent.log; the
  installer's with msiexec /l*v.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="FOG Agent" Language="1033" Version="$(var.Version)"
           Manufacturer="FOG Project" UpgradeCode="7f0c4b3e-2f6a-4d1b-9c8e-5a1d2e3f4b6c">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"
             Description="FOG Agent" Comments="https://fogproject.org" />

    <!-- A newer FOG Agent replaces an older one in place; the state
         directory (key, certificate, server) is untouched, so no
         re-enrollment. -->
    <!-- AllowSameVersionUpgrades because Product Id="*" gives every build a
         fresh ProductCode while the version only moves on a release: two
         builds of 0.1.0 are two different products to Windows Installer,
         and without this the second one registers alongside the first
         instead of replacing it. The lab host carried two "FOG Agent" rows
         in Add/Remove Programs on 2026-09-06 for exactly that reason. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer FOG Agent is already installed." />

    <!-- The legacy client ("FOG Service", fog-client 0.x) is removed as a
         related product. Two agents on one host fight over the same rows:
         its power module consumed an on-demand shutdown before the agent
         saw it (design 0004). Its UpgradeCode is
         {1CCFDEAF-53E9-43AC-AE18-F9F86CEFA4EA}.

         The row that retires it is NOT authored here: wixl (msitools 0.106)
         persists an Upgrade table the Windows Installer engine cannot load
         (error 2229 at FindRelatedProducts, 1603) whenever the table holds
         more than one UpgradeCode. MajorUpgrade already contributes our own
         UpgradeCode's two rows, so a second one here is exactly that case.
         build/msi.sh appends the legacy row with msibuild after wixl, which
         rewrites the table cleanly; LEGACYFOGCLIENT is its ActionProperty
         and MajorUpgrade's RemoveExistingProducts does the removal. -->
    <Property Id="LEGACYFOGCLIENT" Secure="yes" />

    <Media Id="1" Cabinet="fogagent.cab" EmbedCab="yes" />

    <Property Id="SERVER" Secure="yes" />
    <Property Id="CA" Secure="yes" />
    <Property Id="TOKEN" Secure="yes" />

    <!-- The wizard fetches the certificate the server publishes and shows
         its fingerprint for somebody to check against the web UI before
         anything trusts it. Three pieces make that work, because Windows
         Installer has no way for a program to hand a value back:

           AgentProbeExe  the agent itself, a second copy in the Binary
                          table, because the UI sequence runs before
                          InstallFiles and there is nothing on disk yet.
           ProbeCA        runs the probe with its registry flag, clearing and then
                          writes the result under HKCU\Software\FOG\Setup.
                          Return="ignore" so an unreachable server lands on
                          a dialog that says so instead of a 1603.
           RegistrySearch lifts those values into properties, which is what
                          AppSearch is for.

         CAFINGERPRINT is the only one that matters afterwards: the deferred
         setup re-fetches as SYSTEM and refuses anything whose SHA-256 is
         not this. The certificate bytes never cross from the wizard, only
         the fingerprint somebody looked at. -->
    <Binary Id="AgentProbeExe" SourceFile="$(var.Exe)" />
    <!-- ProbeCA is NOT authored here. wixl (msitools 0.106) accepts
         BinaryKey only alongside DllEntry or JScriptCall; BinaryKey with
         ExeCommand, which is custom action type 2, trips an assertion and
         the row is silently dropped. build/msi.sh appends it with msibuild
         after wixl, the same way it appends the legacy Upgrade row, and
         build/check-msi-ui.py fails the build if any DoAction ends up
         naming an action that is not there. -->
    <!-- ReadProbe lifts what the probe wrote into properties. It has to be
         a custom action: the DoAction control event runs custom actions
         ONLY, and handed the name of a standard action it does nothing and
         says nothing, which is how a first attempt at this using AppSearch
         and a RegistrySearch looked exactly like a server that published no
         certificate. The script clears the properties when the key is
         absent, so a failed probe cannot leave the previous server's
         fingerprint on screen to be confirmed. -->
    <Binary Id="ReadProbeJs" SourceFile="build/msi/readprobe.js" />
    <CustomAction Id="ReadProbe" BinaryKey="ReadProbeJs" JScriptCall="ReadProbe"
                  Execute="immediate" Return="ignore" />

    <Property Id="CAFINGERPRINT" Secure="yes" />
    <Property Id="WEBADDRESS" Secure="yes" />
    <Property Id="WEBROOT" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://fogproject.org" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="FOG">
          <Component Id="Agent" Guid="1b2c3d4e-5f60-4718-8a9b-0c1d2e3f4a5b" Win64="yes">
            <File Id="AgentExe" Name="fog-agent.exe" Source="$(var.Exe)" KeyPath="yes" />
            <ServiceInstall Id="AgentService" Name="fog-agent" DisplayName="FOG Agent"
                            Description="Keeps this machine in the state its FOG server describes."
                            Type="ownProcess" Start="auto" ErrorControl="normal"
                            Arguments="run" Vital="yes" />
            <ServiceControl Id="AgentServiceControl" Name="fog-agent"
                            Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- Legacy property names, for deployment scripts written for the old
         client: only when SERVER was not given. -->
    <CustomAction Id="ServerFromLegacyNames" Property="SERVER" Value="https://[WEBADDRESS][WEBROOT]" />

    <!-- setup runs as SYSTEM (Impersonate no) once the exe is on disk and
         before the service starts. Empty properties become empty flags,
         which the agent reads as absent. Return check: a bad CA path or an
         unwritable state directory must fail the install visibly. -->
    <CustomAction Id="Setup" FileKey="AgentExe"
                  ExeCommand="setup --server &quot;[SERVER]&quot; --ca &quot;[CA]&quot; --ca-fingerprint &quot;[CAFINGERPRINT]&quot; --token &quot;[TOKEN]&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="ServerFromLegacyNames" After="InstallInitialize">NOT SERVER AND WEBADDRESS</Custom>
      <Custom Action="Setup" After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <Feature Id="Agent" Title="FOG Agent" Level="1">
      <ComponentRef Id="Agent" />
    </Feature>

    <!-- The wizard, in the fragment below. -->
    <UIRef Id="FogUI" />
  </Product>

  <!--
    The install-time wizard. Windows Installer has no UI of its own: a
    package with no Dialog rows shows a bare progress bar, takes whatever
    properties the command line gave it, and a double-click therefore
    reached `setup` with no server and no CA and failed 1603 with nothing
    on screen to say why. The three things the agent has to be told are
    asked for here instead.

    wixl ships the standard WiX dialog set as its `ui` extension
    (/usr/share/wixl-*/ext/ui); build/msi.sh passes the ui extension flag. What is
    authored below is only the one FOG-specific page and its place in the
    flow: welcome -> FogCfgDlg -> ready -> progress -> finish.

    The dialogs run only under a UI install. `/qn` and `/qb` skip the whole
    InstallUISequence, so a scripted install behaves exactly as it did
    before and still takes SERVER, CA and TOKEN from the command line.
  -->
  <Fragment>
    <UI Id="FogUI">
      <!-- These names are not a choice. Every dialog in wixl's ui extension
           asks for WixUI_Font_Bigger or WixUI_Font_Title in its heading, and
           those rows live in WixUI_Minimal, which this package does not use.
           Defining a differently named style leaves all of them asking for a
           font that is not in the package. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <!-- The stock VerifyReadyDlg and ResumeDlg spawn these two when the
           volume is short of space. wixl pulls in only what is referenced,
           and its own WixUI_Minimal omits them, which leaves a SpawnDialog
           pointing at a dialog that is not in the package: a failure at
           the one moment it is needed. -->
      <DialogRef Id="OutOfDiskDlg" />
      <DialogRef Id="OutOfRbDiskDlg" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="VerifyReadyDlg" />

      <!-- The one page this package adds. Every field carries the example
           the documentation used to keep to itself; the CA line names the
           URL the server publishes it on, because "the FOG CA" means
           nothing to somebody who has never had to find the file. -->
      <Dialog Id="FogCfgDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <!-- ORDER MATTERS, and not for layout: wixl builds Control_Next in
             the order controls are authored and makes the FIRST ONE
             Control_First, whether or not it is in the chain. Windows
             Installer then walks that chain and refuses the dialog with
             error 2834 unless the walk comes back to where it started. So
             every tabbable control is authored first, in the order the
             caret should visit them, and the artwork follows. -->
        <Control Id="ServerEdit" Type="Edit" X="20" Y="68" Width="330" Height="17" Property="SERVER" />
        <Control Id="TokenEdit" Type="Edit" X="20" Y="118" Width="330" Height="17" Property="TOKEN" />
        <Control Id="CaEdit" Type="Edit" X="20" Y="178" Width="330" Height="17" Property="CA" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerTitle" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Your FOG server" />
        <Control Id="BannerDescription" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="The agent enrolls with this server and trusts nothing else." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="ServerLabel" Type="Text" X="20" Y="56" Width="330" Height="10" NoPrefix="yes" Text="&amp;Server address (the FOG web UI address, ending in /fog):" />
        <Control Id="ServerHint" Type="Text" X="20" Y="87" Width="330" Height="10" NoPrefix="yes" Text="Example:  https://fog.example.org/fog" />

        <Control Id="TokenLabel" Type="Text" X="20" Y="106" Width="330" Height="10" NoPrefix="yes" Text="Enrollment &amp;token (optional):" />
        <Control Id="TokenHint" Type="Text" X="20" Y="137" Width="330" Height="10" NoPrefix="yes" Text="Leave this empty to approve the machine by hand in Host Management." />

        <Control Id="MidLine" Type="Line" X="20" Y="157" Width="330" Height="0" />
        <!-- The certificate is normally not typed at all: Next fetches what
             the server publishes and the next page asks somebody to check
             its fingerprint. The field stays for the one case the fetch
             cannot serve, a web UI on a public or corporate certificate. -->
        <Control Id="CaLabel" Type="Text" X="20" Y="166" Width="330" Height="10" NoPrefix="yes" Text="&amp;Certificate file to trust (leave empty for almost every server):" />
        <Control Id="CaHint" Type="Text" X="20" Y="197" Width="330" Height="30" NoPrefix="yes" Text="Empty is right unless your FOG web UI runs on a public or corporate certificate. Otherwise Setup fetches the certificate from the server and asks you to confirm its fingerprint on the next page." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <!-- Ordering matters. The complaint is published first, so a click
             with no server spawns it and never reaches anything below. A
             dialog cannot re-evaluate a control condition as you type, so
             this is the check, not a greyed-out button.
             Then: a typed certificate file skips the fetch entirely;
             otherwise fetch, lift the result into properties, and go to the
             page that shows it. If the fetch found nothing, CAFINGERPRINT
             is empty and the last publish sends the reader somewhere that
             says so. -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="SpawnDialog" Value="FogNeedsCfgDlg" Order="1" Condition="NOT SERVER" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="SERVER AND CA" />
          <Publish Event="DoAction" Value="ProbeCA" Order="3" Condition="SERVER AND NOT CA" />
          <Publish Event="DoAction" Value="ReadProbe" Order="4" Condition="SERVER AND NOT CA" />
          <Publish Event="NewDialog" Value="FogCaDlg" Order="5" Condition="SERVER AND NOT CA AND CAFINGERPRINT" />
          <Publish Event="SpawnDialog" Value="FogNoCaDlg" Order="6" Condition="SERVER AND NOT CA AND NOT CAFINGERPRINT" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- The confirmation. Fetching the certificate over the connection it
           is meant to verify would be trust on first use, which is what the
           old client did; a person comparing this fingerprint against the
           one the server's own web UI prints is what makes it a decision
           taken out of band. Nothing is installed until Next is clicked
           here, and the deferred setup checks the fingerprint again itself
           when it re-fetches as SYSTEM. -->
      <Dialog Id="FogCaDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <!-- Tabbable controls first: see the note in FogCfgDlg. -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="FogCfgDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerTitle" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Is this your server's certificate?" />
        <Control Id="BannerDescription" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="The agent will trust this one and no other." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="Intro" Type="Text" X="20" Y="56" Width="330" Height="20" NoPrefix="yes" Text="[SERVER] offers the certificate below. Compare its fingerprint with the one your FOG server shows before you continue." />

        <Control Id="SubjectLabel" Type="Text" X="20" Y="84" Width="60" Height="10" NoPrefix="yes" Text="Issued to:" />
        <Control Id="SubjectValue" Type="Text" X="82" Y="84" Width="268" Height="20" NoPrefix="yes" Text="[CASUBJECT]" />
        <Control Id="ExpiresLabel" Type="Text" X="20" Y="108" Width="60" Height="10" NoPrefix="yes" Text="Expires:" />
        <Control Id="ExpiresValue" Type="Text" X="82" Y="108" Width="268" Height="10" NoPrefix="yes" Text="[CAEXPIRES]" />

        <Control Id="FpLabel" Type="Text" X="20" Y="128" Width="330" Height="10" NoPrefix="yes" Text="SHA-256 fingerprint:" />
        <Control Id="FpValue" Type="Text" X="20" Y="140" Width="330" Height="30" NoPrefix="yes" Text="[CAFINGERPRINT]" />

        <Control Id="WhereLine" Type="Line" X="20" Y="178" Width="330" Height="0" />
        <Control Id="Where" Type="Text" X="20" Y="186" Width="330" Height="40" NoPrefix="yes" Text="Where to check it: sign in to the FOG web UI and open FOG Configuration, then the Certificates tab. The Root row's SHA-256 column holds the same value. If the two do not match character for character, click Cancel." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <Dialog Id="FogNoCaDlg" Width="290" Height="125" Title="[ProductName] Setup">
        <Control Id="OK" Type="PushButton" X="117" Y="97" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="yes" FixedSize="yes" IconSize="32" TabSkip="no" Text="WixUI_Ico_Exclam" />
        <Control Id="Text" Type="Text" X="48" Y="15" Width="224" Height="70" NoPrefix="yes" Text="Setup could not read a certificate from [SERVER]. Check the address, including https and the /fog on the end, and that this machine can reach the server. If the FOG web UI runs on a public or corporate certificate, give that certificate authority's file in the box instead." />
      </Dialog>

      <!-- One button, and a tab loop still has to close, so the icon is
           left tabbable to be the other half of it. -->
      <Dialog Id="FogNeedsCfgDlg" Width="260" Height="105" Title="[ProductName] Setup">
        <Control Id="OK" Type="PushButton" X="102" Y="77" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="yes" FixedSize="yes" IconSize="32" TabSkip="no" Text="WixUI_Ico_Exclam" />
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="50" NoPrefix="yes" Text="Fill in the server address. The agent cannot reach a server it has not been told about." />
      </Dialog>

      <!-- The flow. A repair or an uninstall never sees FogCfgDlg: the
           state directory already holds the server and the CA, and the
           properties are optional on anything but a first install. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="FogCfgDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="FogCaDlg" Order="1" Condition="NOT Installed AND CAFINGERPRINT AND NOT CA" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="FogCfgDlg" Order="2" Condition="NOT Installed AND (CA OR NOT CAFINGERPRINT)" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="3" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="4" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
